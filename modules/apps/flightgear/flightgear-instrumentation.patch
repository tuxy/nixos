+// Writes the captured frame wherever FG_SCREENSHOT_PATH points.
+class SaveImageToPath : public osgViewer::ScreenCaptureHandler::CaptureOperation
+{
+public:
+    explicit SaveImageToPath(const std::string& p) : _path(p) {}
+
+    void operator()(const osg::Image& image, const unsigned int) override
+    {
+        if (osgDB::writeImageFile(image, _path))
+            SG_LOG(SG_GENERAL, SG_ALERT, "FG_SCREENSHOT wrote " << _path
+                       << " (" << image.s() << "x" << image.t() << ")");
+        else
+            SG_LOG(SG_GENERAL, SG_ALERT, "FG_SCREENSHOT failed for " << _path);
+    }
+
+private:
+    std::string _path;
+};
+
+} // anonymous namespace
+
+namespace {
+
+// FG_SWAP_TIMING=1: time how long the buffer swap actually blocks.  If swap
+// dominates, the main thread is waiting on presentation/GPU backpressure and
+// the CPU and GPU are serialised - which decides whether render-ahead is worth
+// pursuing.  The callback must call the concrete swap itself; that path does
+// not re-enter the callback, so there is no recursion.
+class SwapTimingCallback : public osg::GraphicsContext::SwapCallback
+{
+public:
+    void swapBuffersImplementation(osg::GraphicsContext* gc) override
+    {
+        SGTimeStamp t;
+        t.stamp();
+        gc->swapBuffersImplementation();
+        const double ms = t.elapsedMSec();
+
+        ++_count;
+        _total += ms;
+        if (ms > _max)
+            _max = ms;
+
+        if ((_count % 240) == 0) {
+            SG_LOG(SG_GENERAL, SG_ALERT, "FG_SWAP_TIMING swaps=" << _count
+                       << " avg=" << (_total / double(_count)) << "ms"
+                       << " max=" << _max << "ms");
+        }
+    }
+
+private:
+    unsigned long _count = 0;
+    double _total = 0.0;
+    double _max = 0.0;
+};
+
+} // anonymous namespace

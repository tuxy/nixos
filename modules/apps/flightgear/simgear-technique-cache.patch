diff --git a/simgear/scene/material/Effect.cxx b/simgear/scene/material/Effect.cxx
index ffdfe55..6fcebe2 100644
--- a/simgear/scene/material/Effect.cxx
+++ b/simgear/scene/material/Effect.cxx
@@ -340,10 +340,31 @@ int Effect::getGenerator(Effect::Generator what) const
 
 Technique* Effect::chooseTechnique(RenderInfo* info, const std::string &scheme)
 {
+    {
+        std::lock_guard<std::mutex> lock(_schemeCacheMutex);
+        auto cached = _schemeCache.find(scheme);
+        if (cached != _schemeCache.end()) {
+            Technique* t = cached->second;
+            if (t->valid(info) == Technique::VALID) {
+                return t;
+            }
+            // A scheme is not unique: an Effect may hold several techniques
+            // sharing a scheme and selected by predicate (e.g. ws30.eff's
+            // tessellation variants), and validity also depends on the render
+            // context.  Returning 0 here would make the caller drop the
+            // drawable entirely, so drop the entry and fall through to the
+            // scan, which is exactly the old behaviour.
+            _schemeCache.erase(cached);
+        }
+    }
+
     for (auto& technique : techniques) {
         if ((technique->valid(info) == Technique::VALID) &&
-            (technique->getScheme() == scheme))
+            (technique->getScheme() == scheme)) {
+            std::lock_guard<std::mutex> lock(_schemeCacheMutex);
+            _schemeCache[scheme] = technique.get();
             return technique.get();
+        }
     }
     return 0;
 }

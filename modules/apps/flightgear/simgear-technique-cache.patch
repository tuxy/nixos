@@ -71,6 +72,14 @@ public:
     std::map<Generator, int> generator;  // What is generated into which attribute location
 
     std::vector<osg::ref_ptr<Technique> > techniques;
+
+    /// scheme -> technique.  Techniques never change after build; validity is
+    /// still re-evaluated per call because it depends on the render context.
+    /// chooseTechnique() runs from the cull visitor, i.e. once per geode for
+    /// each of the ~7 scene passes, and used to do a linear scan plus a
+    /// std::string comparison every time.
+    mutable std::mutex _schemeCacheMutex;
+    mutable std::map<std::string, Technique*> _schemeCache;
     SGPropertyNode_ptr root;
     // Pointer to the parameters node, if it exists
     SGPropertyNode_ptr parametersProp;

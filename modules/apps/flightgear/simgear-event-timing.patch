+/**
+ * FG_EVENT_TIMING=1 support: window-scoped per-timer measurement, filled
+ * by SGTimerQueue::update() when non-null, and reported and cleared by
+ * SGEventMgr::update() every 240 updates.  Kept separate from the stock
+ * timingStats map because that map truncates each firing to whole
+ * milliseconds (SGTimeStamp::elapsedMSec), which hides sub-millisecond
+ * timers completely.
+ */
+struct SGTimerQueueTiming {
+    std::map<std::string, double> fineSecs;      ///< per-timer seconds this window (us resolution)
+    std::map<std::string, unsigned long> fires;  ///< per-timer firings this window
+    double totalSecs = 0.0;                      ///< whole-queue seconds this window
+
+    void resetWindow() { fineSecs.clear(); fires.clear(); totalSecs = 0.0; }
+};
+

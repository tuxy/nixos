# A320-family performance changes (aircraft side, not FlightGear source)
# Apply with: cd /home/tuxy/Aircraft && patch -p0 < a320-perf-changes.patch
diff --git a/A320-family/AircraftConfig/acconfig.nas b/A320-family/AircraftConfig/acconfig.nas
--- a/A320-family/AircraftConfig/acconfig.nas	2026-11-16 15:09:33.856259452 +1100
+++ b/A320-family/AircraftConfig/acconfig.nas	2026-11-17 16:46:43.212921534 +1100
@@ -65,7 +65,11 @@
 setprop("/systems/acconfig/options/welcome-skip", 0);
 setprop("/systems/acconfig/options/no-rendering-warn", 0);
 setprop("/systems/acconfig/options/save-state", 0);
-setprop("/systems/acconfig/options/hide-canvas-outside", 0);
+# Perf: default to hiding the glass cockpit when the view is external.  The
+# aircraft already ships this toggle; defaulting it to 0 meant the emesary DU
+# recipients, the 20 Hz ND map rebuilds and the RTT re-renders of the 1024^2
+# canvases all kept running behind an exterior camera.  Cockpit view unchanged.
+setprop("/systems/acconfig/options/hide-canvas-outside", 1);
 setprop("/systems/acconfig/options/separate-tiller-axis", 0);
 setprop("/systems/acconfig/options/nd-rate", 1);
 setprop("/systems/acconfig/options/dcdu-rate", 1);
@@ -210,9 +214,18 @@
 	modelEffects: props.globals.getNode("/sim/gui/dialogs/advanced/model-effects", 1),
 	modelSet: 0,
 	check: func() {
+		# The HDR compositor (the default pipeline in 2024.2) supersedes ALS: it
+		# renders its own sky and shading, so the legacy ALS / landmass /
+		# model-shader requirements do not apply.  Without this guard the dialog
+		# fires on every launch, and its "fix all" path rewrites the rendering
+		# settings the HDR pipeline is actually using.
+		if (props.globals.getNode("/sim/rendering/hdr/render-scale") != nil) {
+			return;
+		}
+
 		me.landmassSet = me.landmass.getValue() >= 4;
 		me.modelSet = me.model.getValue() >= 3;
-		
+
 		if (!me.als.getBoolValue() or !me.landmassSet or !me.modelSet) {
 			fgcommand("dialog-show", props.Node.new({"dialog-name": "aircraft-config-rendering"}));
 		}
@@ -231,6 +244,11 @@
 		me.fixCore();
 	},
 	fixCore: func() {
+		# Never touch ALS under the HDR compositor (see check()).
+		if (props.globals.getNode("/sim/rendering/hdr/render-scale") != nil) {
+			gui.popupTip("HDR pipeline in use: ALS settings left untouched.");
+			return;
+		}
 		me.als.setBoolValue(1); # ALS on
 		me.alsMode.setBoolValue(1);
 		me.lowSpecMode.setBoolValue(0);

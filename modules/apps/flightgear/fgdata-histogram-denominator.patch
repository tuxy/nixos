diff --git a/Shaders/HDR/histogram.glsl b/Shaders/HDR/histogram.glsl
--- a/Shaders/HDR/histogram.glsl	2026-11-17 14:48:13.517219386 +1100
+++ b/Shaders/HDR/histogram.glsl	2026-11-17 14:48:13.521219439 +1100
@@ -51,12 +51,21 @@
  */
 uint histogram_get_total_pixels(usampler2D histogram_tex)
 {
-    uint first_bin_pixels = texelFetch(histogram_tex, ivec2(0), 0).r;
-    // histogram represents all views
-    uint viewport_pixels = 0;
-    for (uint v = 0; v < FG_NUM_VIEWS; ++v)
-        viewport_pixels += uint(fg_Viewport[v].z * fg_Viewport[v].w);
-    return max(viewport_pixels - first_bin_pixels, 0u);
+    // Count the histogram itself.  Deriving the total from fg_Viewport is
+    // wrong whenever the buffer being metered is not the same size as the
+    // window (hdr/render-scale < 1, resize, multiview): fg_Viewport is set per
+    // pass with "last built pass wins" (CompositorPass.cxx), so the last pass -
+    // the full-window AA pass - supplies the window size. The resulting
+    // denominator exceeded the real pixel count, no bin passed the dark check,
+    // valid_pixel_count collapsed to 0 and the adapted luminance fell to zero
+    // until EV pinned at max-ev and the image saturated white.
+    // Summing the bins is exact at any scale, size or view count; 256 fetches
+    // in a 1x1 pass costs nothing.
+    const int nbins = textureSize(histogram_tex, 0).x;
+    uint total_pixels = 0u;
+    for (int i = 0; i < nbins; ++i)
+        total_pixels += texelFetch(histogram_tex, ivec2(i, 0), 0).r;
+    return total_pixels;
 }
 

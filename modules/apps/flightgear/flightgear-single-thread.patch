+namespace {
+
+// Opt-in optimisation: OSG's UpdateVisitor traverses every node in the scene
+// graph.  Groups which contain no update callbacks anywhere below them have no
+// update work at all, so skip their whole subtree.  This is deliberately
+// gated by FG_PRUNE_UPDATE because custom nodes which override traverse() for
+// update work would not be counted by getNumChildrenRequiringUpdateTraversal().
+class FGPruningUpdateVisitor : public osgUtil::UpdateVisitor
+{
+public:
+    void apply(osg::Group& node) override
+    {
+        if (!node.getUpdateCallback() &&
+            node.getNumChildrenRequiringUpdateTraversal() == 0)
+        {
+            return;
+        }
+        osgUtil::UpdateVisitor::apply(node);
+    }
+};
+
+} // anonymous namespace
+

@@ -1730,7 +1732,40 @@ void FGNasalSys::setTimer(naContext c, int argc, naRef* args)
 
 void FGNasalSys::handleTimer(NasalTimer* t)
 {
+    // FG_NASAL_CB_TIMING=1 attributes per-frame Nasal timer cost by call site.
+    // The A320-family spends ~30 ms/frame in subsystem updates against ~2.6 ms
+    // for the ufo, so this is where an aircraft becomes CPU bound.
+    static const bool cbTiming = std::getenv("FG_NASAL_CB_TIMING") != nullptr;
+    const auto cbStart = std::chrono::steady_clock::now();
+    const std::string cbName = cbTiming ? t->name : std::string();
+
     call(t->handler, 0, 0, naNil());
+
+    if (cbTiming) {
+        const double ms = std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - cbStart).count();
+        static std::map<std::string, std::pair<double, unsigned> > cbStats;
+        static unsigned cbCalls = 0;
+        auto& e = cbStats[cbName];
+        e.first += ms;
+        e.second++;
+        if ((++cbCalls % 600) == 0) {
+            std::multimap<double, std::string> top;
+            for (const auto& kv : cbStats)
+                top.insert(std::make_pair(kv.second.first, kv.first));
+            std::ostringstream os;
+            unsigned shown = 0;
+            for (auto it = top.rbegin(); it != top.rend() && shown < 6; ++it, ++shown) {
+                const auto& st = cbStats[it->second];
+                os << " [" << it->second << " " << (st.first / st.second) << "ms x" << st.second << "]";
+            }
+            SG_LOG(SG_GENERAL, SG_ALERT, "FG_NASAL_CB_TIMING calls=" << cbCalls
+                   << " total=" << ([&]{ double t2 = 0; for (const auto& kv : cbStats) t2 += kv.second.first; return t2; })()
+                   << "ms top:" << os.str());
+            cbStats.clear();
+            cbCalls = 0;
+        }
+    }
     auto it = std::find(d->_nasalTimers.begin(), d->_nasalTimers.end(), t);
     assert(it != d->_nasalTimers.end());
     d->_nasalTimers.erase(it);

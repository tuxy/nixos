+// --- performance instrumentation -------------------------------------------
+// FG_NASAL_GC=1 logs one line per collection (count, duration, heap size) to
+// stderr.  FG_NASAL_GC_BUDGET is the percentage of a pool which may be
+// allocated between collections (default 50, the historical behaviour);
+// raising it trades memory for fewer, longer pauses.
+
+static int gcStats(void)
+{
+    static int cached = -1;
+    if(cached < 0) cached = getenv("FG_NASAL_GC") != 0;
+    return cached;
+}
+
+static int gcBudgetPercent(void)
+{
+    static int cached = -1;
+    if(cached < 0) {
+        const char* s = getenv("FG_NASAL_GC_BUDGET");
+        cached = (s && *s) ? atoi(s) : 50;
+        if(cached < 10) cached = 10;
+        if(cached > 400) cached = 400;
+    }
+    return cached;
+}
+
+static int gcReapEnabled(void)
+{
+    static int cached = -1;
+    if(cached < 0) {
+        const char* s = getenv("FG_NASAL_GC_REAP");
+        cached = !(s && *s == '0');
+    }
+    return cached;
+}
+
+static void gcHeapStats(int* live, int* total, int* blocks)
+{
+    int i;
+    *live = *total = *blocks = 0;
+    for(i=0; i<NUM_NASAL_TYPES; i++) {
+        struct naPool* p = &(globals->pools[i]);
+        struct Block* b;
+        int t = poolsize(p);
+        *total += t;
+        *live += t - p->nfree;
+        for(b = p->blocks; b; b = b->next) (*blocks)++;
+    }
+}
+
 // Must be called with the big lock!
 static void garbageCollect()
 {
     int i;
     struct Context* c;
+    struct timespec gcStart;
+    const int wantStats = gcStats();
+    static unsigned long gcCount = 0;
+    if(wantStats) clock_gettime(CLOCK_MONOTONIC, &gcStart);
     globals->allocCount = 0;
     c = globals->allContexts;
     while(c) {
@@ -78,6 +136,18 @@ static void garbageCollect()
         globals->deadBlocks = naAlloc(sizeof(void*) * globals->deadsz);
     }
     globals->needGC = 0;
+
+    if(wantStats) {
+        struct timespec gcEnd;
+        int live, total, blocks;
+        double ms;
+        clock_gettime(CLOCK_MONOTONIC, &gcEnd);
+        ms = (double)(gcEnd.tv_sec - gcStart.tv_sec) * 1000.0
+           + (double)(gcEnd.tv_nsec - gcStart.tv_nsec) / 1.0e6;
+        gcHeapStats(&live, &total, &blocks);
+        fprintf(stderr, "FG_NASAL_GC #%lu %.2fms live=%d total=%d blocks=%d\n",
+                ++gcCount, ms, live, total, blocks);
+    }
 }
 

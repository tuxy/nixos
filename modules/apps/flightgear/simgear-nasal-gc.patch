@@ -284,7 +354,31 @@ void naiGCMark(naRef r)
 static void reap(struct naPool* p)
 {
     struct Block* b;
-    int elem, freesz, total = poolsize(p);
+    struct Block** prev;
+    int elem, freesz, total;
+
+    // Pass 1: unlink blocks which no longer hold a single live object.  The
+    // pool used to only ever grow, so one transient (a big table, a loaded
+    // Nasal module) made every later collection walk dead memory for the rest
+    // of the session.  Release such memory back to the allocator instead.
+    prev = &p->blocks;
+    while(gcReapEnabled() && (b = *prev) != 0) {
+        int blocklive = 0;
+        for(elem = 0; elem < b->size; elem++) {
+            struct naObj* o = (struct naObj*)(b->block + elem * p->elemsz);
+            if(o->mark) blocklive++;
+        }
+        // Never drop the last block of the pool.
+        if(blocklive == 0 && !(b == p->blocks && b->next == 0)) {
+            *prev = b->next;
+            naFree(b->block);
+            naFree(b);
+        } else {
+            prev = &b->next;
+        }
+    }
+
+    total = poolsize(p);
     freesz = total < MIN_BLOCK_SIZE ? MIN_BLOCK_SIZE : total;
     freesz = (3 * freesz / 2) + (globals->nThreads * OBJ_CACHE_SZ);
     if(p->freesz < freesz) {
@@ -295,6 +389,7 @@ static void reap(struct naPool* p)
         p->free = p->free0 = naAlloc(sizeof(void*) * p->freesz);
     }
 
+    // Pass 2: rebuild the free list from the surviving (still marked) blocks.
     p->nfree = 0;
     p->free = p->free0;
 
@@ -308,15 +403,14 @@ static void reap(struct naPool* p)
 
